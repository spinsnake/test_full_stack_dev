# =========================
# App
# =========================
APP_NAME=image-gallery-api
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_TIMEZONE=Asia/Bangkok

# =========================
# HTTP / API
# =========================
API_PREFIX=/api
READ_TIMEOUT_SEC=15
WRITE_TIMEOUT_SEC=15
IDLE_TIMEOUT_SEC=60
SHUTDOWN_TIMEOUT_SEC=10

# =========================
# Logging
# =========================
LOG_LEVEL=debug
LOG_FORMAT=text

# =========================
# CORS
# Comma-separated list for local dev/frontends
# =========================
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIALS=false

# =========================
# Gallery / Pagination
# =========================
DEFAULT_PAGE_LIMIT=12
MAX_PAGE_LIMIT=60
MOCKDATA=false
AUTO_MIGRATE=false

# =========================
# MySQL (build DSN from these in app)
# =========================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=gallery_db
MYSQL_PARAMS=parseTime=true&loc=Local&charset=utf8mb4&multiStatements=true

# Optional ready-to-use DSN for Go sql driver
# Format: user:pass@tcp(host:port)/db?params
DATABASE_DSN=root:change_me@tcp(127.0.0.1:3306)/gallery_db?parseTime=true&loc=Local&charset=utf8mb4&multiStatements=true

# =========================
# Connection Pool
# =========================
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_MIN=30
DB_CONN_MAX_IDLE_TIME_MIN=10

# =========================
# Migration CLI (golang-migrate)
# Use URL-encoded password if it has special chars
# =========================
MIGRATION_PATH=backend/migration
MIGRATE_DATABASE_URL=mysql://root:change_me@tcp(127.0.0.1:3306)/gallery_db?x-multi-statement=true
